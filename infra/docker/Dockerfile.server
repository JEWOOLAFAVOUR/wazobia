FROM golang:1.23-alpine AS build
WORKDIR /src
COPY apps/server/go.mod apps/server/go.sum ./apps/server/
WORKDIR /src/apps/server
RUN go mod download
COPY apps/server/ .
RUN CGO_ENABLED=0 go build -o /bin/wazobia-server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /bin/wazobia-server /usr/local/bin/wazobia-server
EXPOSE 8080
CMD ["wazobia-server"]
